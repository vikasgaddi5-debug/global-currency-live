{
  "expo": {
    "name": "Global Currency Live",
    "slug": "global-currency-live",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.globalcurrencylive",
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "NSUserNotificationsUsageDescription": "We use notifications to alert you about currency rate changes and trend reversals you configure."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1220"
      },
      "package": "com.yourcompany.globalcurrencylive",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": ["expo-notifications"],
    "extra": {
      "apiBaseUrl": "https://your-backend.example.com/api"
    }
  }
}
